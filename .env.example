# ===== eaTrack – configuration =====

# Public address of the app (used in email links and for the OIDC callback)
EATRACK_URL=https://eatrack.example.com

# Sign-up: "open" (anyone) or "closed" (only through an invitation link)
EATRACK_SIGNUP=open

# In production behind HTTPS: cookies only over secure connections
EATRACK_COOKIE_SECURE=1
# Set to 1 when a reverse proxy sits in front (nginx, Caddy, Traefik…)
EATRACK_PROXY=1

# Email (address confirmation and password recovery). Without SMTP the links are written to the log.
EATRACK_SMTP_HOST=
EATRACK_SMTP_PORT=587
EATRACK_SMTP_USER=
EATRACK_SMTP_PASSWORD=
EATRACK_MAIL_FROM=eaTrack <noreply@example.com>

# Sign-in with external providers (OpenID Connect), comma separated. Leave empty to disable.
# Callback URL to register with the provider: <EATRACK_URL>/api/oidc/<name>/callback
EATRACK_OIDC=
# Google (console.cloud.google.com → Credentials → OAuth client ID, "Web application")
EATRACK_OIDC_GOOGLE_ID=
EATRACK_OIDC_GOOGLE_SECRET=
# Any other OIDC provider, e.g. EATRACK_OIDC=google,microsoft
# EATRACK_OIDC_MICROSOFT_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# EATRACK_OIDC_MICROSOFT_ID=
# EATRACK_OIDC_MICROSOFT_SECRET=
# EATRACK_OIDC_MICROSOFT_NAME=Microsoft

# How many daily automatic database backups to keep
EATRACK_BACKUP_KEEP=30

# ----- weHub: one sign-in and one family for all the family apps (optional) -----
# With these set, sign-in goes only through the OIDC provider (the same Pocket ID as weHub) and the family, its
# members and people are managed in weHub. Key: the same as WEHUB_APP_EATRACK_KEY in weHub.
EATRACK_HUB_URL=
EATRACK_HUB_KEY=
# Address of weHub for people (links), if different from EATRACK_HUB_URL (e.g. an internal Docker address)
EATRACK_HUB_PUBLIC_URL=
